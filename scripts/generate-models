#!/usr/bin/env ruby
# frozen_string_literal: true

# Regenerates lib/stampmitra/models.rb from the named component schemas in spec/openapi.json.
#
#   scripts/generate-models           # rewrite lib/stampmitra/models.rb
#   scripts/generate-models --check   # exit 1 when the committed file is stale (CI)
require 'json'

ROOT = File.expand_path('..', __dir__)
SPEC = JSON.parse(File.read(File.join(ROOT, 'spec/openapi.json')))
SCHEMAS = SPEC.dig('components', 'schemas')
TARGET = File.join(ROOT, 'lib/stampmitra/models.rb')

# schema name => class name
CLASSES = {
  'PanVerificationResult' => 'PanVerification',
  'GstinVerificationResult' => 'GstinVerification',
  'VehicleRcVerificationResult' => 'RcVerification',
  'VoterIdVerificationResult' => 'VoterIdVerification',
  'DrivingLicenseVerificationResult' => 'DrivingLicenseVerification',
  'PassportVerificationResult' => 'PassportVerification',
  'CinDirector' => 'CinDirector',
  'CinVerificationResult' => 'CinVerification',
  'UdyamVerificationResult' => 'UdyamVerification',
  'PanToGstinEntry' => 'PanToGstinEntry',
  'PanToGstinResult' => 'PanToGstin',
  'PanToUdyamResult' => 'PanToUdyam',
  'IfscDetails' => 'IfscDetails',
  'BankAccountVerificationResult' => 'BankAccountVerification',
  'Service' => 'Service',
  'OrderReference' => 'OrderReference',
  'OrderDetail' => 'OrderDetail',
  'OrderStatusResponse' => 'OrderStatus',
  'OrderPaymentResponse' => 'OrderPayment',
  'OrderDocumentsResponse' => 'OrderDocuments',
  'DocumentDownloadUrl' => 'DocumentDownloadUrl',
  'PaymentIntent' => 'PaymentIntent',
  'UsageSummary' => 'UsageSummary',
  'LogEntry' => 'LogEntry',
  'LogsPage' => 'LogsPage'
}.freeze

def snake(key)
  key.gsub(/([A-Z]+)([A-Z][a-z])/, '\1_\2').gsub(/([a-z\d])([A-Z])/, '\1_\2').downcase
end

def camel(name)
  head, *rest = name.split('_')
  head + rest.map(&:capitalize).join
end

def one_line(text)
  text.to_s.gsub(/\s+/, ' ').strip
end

def ruby_type(prop, required)
  ref = prop['$ref'] || prop.dig('items', '$ref')
  base =
    if ref
      klass = CLASSES.fetch(ref.split('/').last)
      prop['type'] == 'array' ? "Array<#{klass}>" : klass
    else
      types = Array(prop['type'])
      names = types.reject { |t| t == 'null' }.map do |t|
        { 'string' => 'String', 'integer' => 'Integer', 'number' => 'Float', 'boolean' => 'Boolean',
          'object' => 'Hash', 'array' => 'Array' }.fetch(t)
      end
      names.empty? ? 'Object' : names.join(', ')
    end
  nullable = !required || Array(prop['type']).include?('null')
  nullable && base != 'Object' ? "#{base}, nil" : base
end

out = +"# frozen_string_literal: true\n\n"
out << "# GENERATED by scripts/generate-models from spec/openapi.json. Do not edit by hand.\n\n"
out << "module StampMitra\n"
out << "  # Typed response models, one per named response schema in the OpenAPI spec.\n"
out << "  module Models\n"
CLASSES.each_with_index do |(schema_name, klass), index|
  schema = SCHEMAS.fetch(schema_name)
  required = schema['required'] || []
  out << "\n" unless index.zero?
  out << "    # #{one_line(schema['description'] || schema_name)}\n"
  out << "    class #{klass} < Model\n"
  (schema['properties'] || {}).each_with_index do |(key, prop), i|
    name = snake(key)
    out << "\n" unless i.zero?
    out << "      # @!attribute [r] #{name}\n"
    out << "      #   @return [#{ruby_type(prop, required.include?(key))}] #{one_line(prop['description'] || key)}\n"
    ref = prop['$ref'] || prop.dig('items', '$ref')
    args = [":#{name}"]
    args << "'#{key}'" unless camel(name) == key
    args << "model: #{CLASSES.fetch(ref.split('/').last)}" if ref
    args << 'list: true' if prop['type'] == 'array' && ref
    out << "      attribute #{args.join(', ')}\n"
  end
  out << "    end\n"
end
out << "\n"
out << "    # Services your organization is entitled to (a bare JSON array on the wire). Enumerable over {Service}.\n"
out << "    class ServiceList\n"
out << "      include Enumerable\n\n"
out << "      # @return [Array<Service>]\n"
out << "      attr_reader :services\n"
out << "      # @return [Response, nil] HTTP metadata\n"
out << "      attr_reader :response\n\n"
out << "      # @param data [Array<Hash>] decoded JSON array\n"
out << "      # @param response [Response, nil]\n"
out << "      def initialize(data = [], response: nil)\n"
out << "        @services = Array(data).map { |item| item.is_a?(Hash) ? Service.new(item) : item }.freeze\n"
out << "        @response = response\n"
out << "      end\n\n"
out << "      # @yieldparam service [Service]\n"
out << "      # @return [Enumerator, Array<Service>]\n"
out << "      def each(&block)\n"
out << "        return services.each unless block\n\n"
out << "        services.each(&block)\n"
out << "      end\n\n"
out << "      # @return [Integer] number of services\n"
out << "      def size\n"
out << "        services.size\n"
out << "      end\n\n"
out << "      # @param index [Integer]\n"
out << "      # @return [Service, nil]\n"
out << "      def [](index)\n"
out << "        services[index]\n"
out << "      end\n\n"
out << "      # @return [Array<Hash>] deep copies of the raw service objects\n"
out << "      def to_h\n"
out << "        services.map(&:to_h)\n"
out << "      end\n\n"
out << "      # @return [ServiceList] a copy carrying +response+\n"
out << "      def with_response(response)\n"
out << "        self.class.new(to_h, response: response)\n"
out << "      end\n"
out << "    end\n"
out << "  end\n"
out << "end\n"

if ARGV.include?('--check')
  current = File.exist?(TARGET) ? File.read(TARGET) : ''
  if current == out
    puts 'OK: lib/stampmitra/models.rb is up to date with spec/openapi.json'
  else
    warn 'lib/stampmitra/models.rb is stale: run scripts/generate-models'
    exit 1
  end
else
  File.write(TARGET, out)
  puts "wrote #{TARGET} (#{CLASSES.size} models + ServiceList)"
end
