#!/usr/bin/env ruby
# frozen_string_literal: true

# Regenerates lib/stampmitra/models.rb from the named component schemas in spec/openapi.json.
#
#   scripts/generate-models           # rewrite lib/stampmitra/models.rb
#   scripts/generate-models --check   # exit 1 when the committed file is stale (CI)
require 'json'

ROOT = File.expand_path('..', __dir__)
SPEC = JSON.parse(File.read(File.join(ROOT, 'spec/openapi.json'), encoding: 'UTF-8'))
SCHEMAS = SPEC.dig('components', 'schemas')
TARGET = File.join(ROOT, 'lib/stampmitra/models.rb')

# schema name => class name
CLASSES = {
  'PanVerificationResult' => 'PanVerification',
  'GstinVerificationResult' => 'GstinVerification',
  'VehicleRcVerificationResult' => 'RcVerification',
  'VoterIdVerificationResult' => 'VoterIdVerification',
  'DrivingLicenseVerificationResult' => 'DrivingLicenseVerification',
  'PassportVerificationResult' => 'PassportVerification',
  'CinDirector' => 'CinDirector',
  'CinVerificationResult' => 'CinVerification',
  'UdyamVerificationResult' => 'UdyamVerification',
  'PanToGstinEntry' => 'PanToGstinEntry',
  'PanToGstinResult' => 'PanToGstin',
  'PanToUdyamResult' => 'PanToUdyam',
  'IfscDetails' => 'IfscDetails',
  'BankAccountVerificationResult' => 'BankAccountVerification',
  'Service' => 'Service',
  'OrderReference' => 'OrderReference',
  'OrderDetail' => 'OrderDetail',
  'OrderStatusResponse' => 'OrderStatus',
  'OrderPaymentResponse' => 'OrderPayment',
  'OrderDocumentsResponse' => 'OrderDocuments',
  'DocumentDownloadUrl' => 'DocumentDownloadUrl',
  'PaymentIntent' => 'PaymentIntent',
  'UsageSummary' => 'UsageSummary',
  'LogEntry' => 'LogEntry',
  'LogsPage' => 'LogsPage',
  'EstampOrderQuote' => 'EstampOrderQuote',
  'EstampDocumentRequirement' => 'EstampDocumentRequirement',
  'EstampValidationIssue' => 'EstampValidationIssue',
  'EstampOrderCounts' => 'EstampOrderCounts',
  'EstampValidateResult' => 'EstampValidateResult',
  'EstampStateAvailability' => 'EstampStateAvailability',
  'EstampStatesAvailability' => 'EstampStatesAvailability',
  'EstampState' => 'EstampState',
  'EstampRequirements' => 'EstampRequirements',
  'EstampDistrict' => 'EstampDistrict',
  'EstampSro' => 'EstampSro',
  'EstampOrderStampRef' => 'EstampOrderStampRef',
  'EstampOrderAdvisory' => 'EstampOrderAdvisory',
  'EstampOrder' => 'EstampOrder',
  'EstampOrderList' => 'EstampOrderList',
  'EstampOrderExport' => 'EstampOrderExport',
  'EstampDocument' => 'EstampDocument',
  'EstampPanCardStatus' => 'EstampPanCardStatus',
  'EstampStamp' => 'EstampStamp',
  'EstampStampList' => 'EstampStampList',
  'EstampPanCardResult' => 'EstampPanCardResult',
  'EstampCertificate' => 'EstampCertificate',
  'EstampWalletPart' => 'EstampWalletPart',
  'EstampWallet' => 'EstampWallet',
  'WalletBalance' => 'WalletBalance',
  'WalletTransaction' => 'WalletTransaction',
  'WalletTransactionsPage' => 'WalletTransactionsPage',
  'WalletInvoice' => 'WalletInvoice',
  'WalletInvoicesPage' => 'WalletInvoicesPage',
  'StampDutyWalletInvoice' => 'StampDutyWalletInvoice',
  'StampDutyWalletInvoicesPage' => 'StampDutyWalletInvoicesPage',
  'StampDutyWalletTopup' => 'StampDutyWalletTopup',
  'ServiceFeeWalletTopup' => 'ServiceFeeWalletTopup',
  'AccountBalance' => 'AccountBalance',
  'AccountUsage' => 'AccountUsage'
}.freeze

# Responses that are a bare JSON array: schema => [class, item class, reader, plural noun, description]
LISTS = {
  'ServiceList' => ['ServiceList', 'Service', 'services', 'services', 'Services your organization is entitled to'],
  'EstampDistrictList' => ['EstampDistrictList', 'EstampDistrict', 'districts', 'districts', 'Districts of an e-Stamp state'],
  'EstampSroList' => ['EstampSroList', 'EstampSro', 'sros', 'sub-registrar offices', 'Sub-registrar offices of a district']
}.freeze

def snake(key)
  key.gsub(/([A-Z]+)([A-Z][a-z])/, '\1_\2').gsub(/([a-z\d])([A-Z])/, '\1_\2').downcase
end

def camel(name)
  head, *rest = name.split('_')
  head + rest.map(&:capitalize).join
end

def one_line(text)
  text.to_s.gsub(/\s+/, ' ').strip
end

# Schema name referenced by a property: a direct $ref, an array item $ref, or a nullable oneOf [$ref, null].
def ref_name(prop)
  ref = prop['$ref'] || prop.dig('items', '$ref')
  if ref.nil? && Array(prop['oneOf']).size == 2 && Array(prop['oneOf']).any? { |o| o['type'] == 'null' }
    ref = Array(prop['oneOf']).filter_map { |o| o['$ref'] }.first
  end
  ref&.split('/')&.last
end

def array?(prop)
  Array(prop['type']).include?('array')
end

# Nested objects without a model of their own (older verification schemas) stay raw Hashes.
def model_for(prop)
  CLASSES[ref_name(prop)]
end

def ruby_type(prop, required)
  klass = model_for(prop)
  base =
    if klass
      array?(prop) ? "Array<#{klass}>" : klass
    elsif ref_name(prop)
      array?(prop) ? 'Array<Hash>' : 'Hash'
    else
      names = Array(prop['type']).reject { |t| t == 'null' }.map do |t|
        { 'string' => 'String', 'integer' => 'Integer', 'number' => 'Float', 'boolean' => 'Boolean',
          'object' => 'Hash', 'array' => 'Array' }.fetch(t)
      end
      names.empty? ? 'Object' : names.join(', ')
    end
  nullable = !required || Array(prop['type']).include?('null') || Array(prop['oneOf']).any? { |o| o['type'] == 'null' }
  nullable && base != 'Object' ? "#{base}, nil" : base
end

out = +"# frozen_string_literal: true\n\n"
out << "# GENERATED by scripts/generate-models from spec/openapi.json. Do not edit by hand.\n\n"
out << "module StampMitra\n"
out << "  # Typed response models, one per named response schema in the OpenAPI spec.\n"
out << "  module Models\n"
CLASSES.each_with_index do |(schema_name, klass), index|
  schema = SCHEMAS.fetch(schema_name)
  required = schema['required'] || []
  out << "\n" unless index.zero?
  out << "    # #{one_line(schema['description'] || schema_name)}\n"
  out << "    class #{klass} < Model\n"
  seen = []
  (schema['properties'] || {}).each_with_index do |(key, prop), i|
    name = snake(key)
    name = "#{name}_legacy" if seen.include?(name) # e.g. GSTIN next to gstin: a second key that snake_cases to the same reader
    seen << name
    out << "\n" unless i.zero?
    out << "      # @!attribute [r] #{name}\n"
    out << "      #   @return [#{ruby_type(prop, required.include?(key))}] #{one_line(prop['description'] || key)}\n"
    klass = model_for(prop)
    args = [":#{name}"]
    args << "'#{key}'" unless camel(name) == key
    args << "model: #{klass}" if klass
    args << 'list: true' if array?(prop) && klass
    out << "      attribute #{args.join(', ')}\n"
  end
  out << "    end\n"
end
def emit_list(out, klass, item, reader, noun, description) # rubocop:disable Metrics/ParameterLists
  out << "\n"
  out << "    # #{description} (a bare JSON array on the wire). Enumerable over {#{item}}.\n"
  out << "    class #{klass}\n"
  out << "      include Enumerable\n\n"
  out << "      # @return [Array<#{item}>]\n"
  out << "      attr_reader :#{reader}\n"
  out << "      # @return [Response, nil] HTTP metadata\n"
  out << "      attr_reader :response\n\n"
  out << "      # @param data [Array<Hash>] decoded JSON array\n"
  out << "      # @param response [Response, nil]\n"
  out << "      def initialize(data = [], response: nil)\n"
  out << "        @#{reader} = Array(data).map { |entry| entry.is_a?(Hash) ? #{item}.new(entry) : entry }.freeze\n"
  out << "        @response = response\n"
  out << "      end\n\n"
  out << "      # @yieldparam entry [#{item}]\n"
  out << "      # @return [Enumerator, Array<#{item}>]\n"
  out << "      def each(&block)\n"
  out << "        return #{reader}.each unless block\n\n"
  out << "        #{reader}.each(&block)\n"
  out << "      end\n\n"
  out << "      # @return [Integer] number of #{noun}\n"
  out << "      def size\n"
  out << "        #{reader}.size\n"
  out << "      end\n\n"
  out << "      # @param index [Integer]\n"
  out << "      # @return [#{item}, nil]\n"
  out << "      def [](index)\n"
  out << "        #{reader}[index]\n"
  out << "      end\n\n"
  out << "      # @return [Array<Hash>] deep copies of the raw objects\n"
  out << "      def to_h\n"
  out << "        #{reader}.map(&:to_h)\n"
  out << "      end\n\n"
  out << "      # @return [#{klass}] a copy carrying +response+\n"
  out << "      def with_response(response)\n"
  out << "        self.class.new(to_h, response: response)\n"
  out << "      end\n"
  out << "    end\n"
end

LISTS.each_value { |entry| emit_list(out, *entry) }

out << "  end\n"
out << "end\n"

if ARGV.include?('--check')
  current = File.exist?(TARGET) ? File.read(TARGET, encoding: 'UTF-8') : ''
  if current == out
    puts 'OK: lib/stampmitra/models.rb is up to date with spec/openapi.json'
  else
    warn 'lib/stampmitra/models.rb is stale: run scripts/generate-models'
    exit 1
  end
else
  File.write(TARGET, out, encoding: 'UTF-8')
  puts "wrote #{TARGET} (#{CLASSES.size} models + #{LISTS.size} list models)"
end
